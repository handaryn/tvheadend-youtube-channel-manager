<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.tvh.youtube.channels" name="TVHeadend YouTube Channels" version="1.0.0" provider-name="HomeLab">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Add YouTube Live Channels directly to TVHeadend &amp; Kodi TV Guide</summary>
        <description lang="en_GB">Search YouTube channels, preview icons/details, and add or remove live streams into TVHeadend with automatic picons and guide tags.</description>
        <platform>all</platform>
        <license>GPL-2.0-or-later</license>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
